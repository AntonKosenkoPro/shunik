// Configuration settings file for Shunik — Debug.
// API base URL is injected via Info.plist so runtime code can read it.

// xcconfig treats `//` as a comment, so we break it with an empty variable.
// The $(EMPTY) reference expands to nothing, resulting in http://127.0.0.1:8080.
EMPTY =
API_BASE_URL = http:/$(EMPTY)/127.0.0.1:8080

// Sentry DSN (observability Stage 0): empty = crash reporting disabled.
// Self-reference resolves from the environment, so Xcode Cloud workflow env
// vars flow in; unset locally expands to empty (local builds stay silent).
// CI also overrides this on the xcodebuild command line from the SENTRY_IOS_DSN
// secret (`xcodebuild ... SENTRY_DSN="$SENTRY_IOS_DSN"`).
SENTRY_DSN = $(SENTRY_DSN)