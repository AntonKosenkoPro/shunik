DATABASE_URL=postgres://postgres:postgres@localhost:5432/timeoflife?sslmode=disable
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes-long
EMAIL_BACKEND=console
PORT=8080
OTP_EXPIRY=10m
OTP_MAX_ATTEMPTS=5

# Optional: override the OTP email body templates (Go text/template). The code
# MUST stay on its own line in the text body for iOS .oneTimeCode autofill.
#OTP_EMAIL_TEMPLATE=
#OTP_EMAIL_HTML_TEMPLATE=

# AWS SES (EMAIL_BACKEND=ses) — the real mail sender. All four are required
# when EMAIL_BACKEND=ses. In production, .env is NOT hand-edited on the VM: the
# CI/CD pipeline (`.github/workflows/backend.yml`) regenerates /opt/timeoflife/.env
# from GitHub Actions encrypted secrets on every deploy. This file is only the
# local-dev template. Never commit real credentials.
# Before sending to arbitrary recipients, verify a sending domain/email and
# request SES Production access (the sandbox only delivers to verified addresses).
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_REGION=eu-west-1
#SES_FROM=noreply@your-verified-domain.com

# Sign in with Apple (F2). Leave APPLE_CLIENT_ID empty to disable the feature
# (the /auth/apple route is always registered but returns 503 apple_not_configured
# when unconfigured, and the iOS button is inert).
# When enabled, set it to the app's Bundle ID — Apple puts the Bundle ID in the
# identity token's `aud` claim for a native iOS app.
#APPLE_CLIENT_ID=com.antonkosenko.timeoflifeapp
#APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Trusted reverse proxies (FURPS R1/S5). Comma-separated IPs/CIDRs allowed to
# set X-Forwarded-For / X-Real-IP, which are used for per-client rate limiting.
# Empty (default) = trust nobody: forwarded headers are ignored and the direct
# TCP peer is used. Set this to your load balancer/proxy CIDR in production so
# rate limiting sees the real client IP; otherwise clients can spoof the header
# to bypass rate limits.
#TRUSTED_PROXIES=10.0.0.0/8
# CORS allowlist (issue #93). Comma-separated exact origins
# (scheme://host[:port]) echoed with Allow-Credentials for browser calls.
# Empty (default) = deny all: no Origin is reflected and no credentials are
# advertised (native iOS callers ignore CORS and are unaffected).
# Localhost dev origins work only via explicit listing.
#CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry error reporting (observability Stage 0). Empty (default) = fully
# disabled, zero behavior change. Never commit a real DSN.
#SENTRY_DSN=

# Refresh recovery keyring (fix-refresh-response-loss). REQUIRED: the server
# fails fast at startup without it. Comma-separated hex-encoded 32-byte
# (AES-256) keys sealing pending refresh successors; the first is the
# primary sealing key, the rest are retired keys retained for decrypting
# older receipts. Generate with `openssl rand -hex 32` and keep stable
# across deploys and key rotation — losing all keys orphans pending
# receipts until their refresh TTL elapses (clients re-authenticate).
# Roll back by deploying the previous binary (it ignores this variable);
# never delete pending receipts as part of a rollback.
#REFRESH_RECOVERY_KEYS=<64-hex-chars>[,<64-hex-chars>...]

# Test-only: PostgreSQL parity tests (R-007) read this DSN. Leave unset to run
# the SQLite suite only. `make test:pg` sets it for you against docker-compose.
#TEST_PG_DSN=postgres://postgres:postgres@localhost:5432/timeoflife_test?sslmode=disable
